exports[`Python generator > generates the same Python for variables and functions 1`] = `
"from XRPLib.differential_drive import DifferentialDrive

side = None

differentialDrive = DifferentialDrive.get_default_differential_drive()

def drive_square():
  global side
  for count in range(4):
    side = 20
    differentialDrive.straight(side, 0.5)


drive_square()
"
`;
