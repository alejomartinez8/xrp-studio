exports[`Python generator > generates the same Python for every example > avoidObstacles 1`] = `
"from XRPLib.board import Board
from XRPLib.rangefinder import Rangefinder
from XRPLib.differential_drive import DifferentialDrive

board = Board.get_default_board()

rangefinder = Rangefinder.get_default_rangefinder()

differentialDrive = DifferentialDrive.get_default_differential_drive()


board.wait_for_button()
while True:
  if (rangefinder.distance()) < 20:
    differentialDrive.stop()
    differentialDrive.turn(90, 0.5)
  else:
    differentialDrive.set_effort(0.5, 0.5)
"
`;

exports[`Python generator > generates the same Python for every example > driveAndTurn 1`] = `
"from XRPLib.board import Board
from XRPLib.differential_drive import DifferentialDrive

board = Board.get_default_board()

differentialDrive = DifferentialDrive.get_default_differential_drive()


board.wait_for_button()
differentialDrive.straight(30, 0.5)
differentialDrive.turn(180, 0.5)
differentialDrive.straight(30, 0.5)
board.led_on()
"
`;

exports[`Python generator > generates the same Python for every example > followLine 1`] = `
"from XRPLib.board import Board
from XRPLib.reflectance import Reflectance
from XRPLib.differential_drive import DifferentialDrive

board = Board.get_default_board()

reflectance = Reflectance.get_default_reflectance()

differentialDrive = DifferentialDrive.get_default_differential_drive()


board.wait_for_button()
while True:
  if (reflectance.get_left()) > (reflectance.get_right()):
    differentialDrive.set_effort(0.2, 0.5)
  else:
    differentialDrive.set_effort(0.5, 0.2)
"
`;

exports[`Python generator > generates the same Python for every example > square 1`] = `
"from XRPLib.board import Board
from XRPLib.differential_drive import DifferentialDrive

board = Board.get_default_board()

differentialDrive = DifferentialDrive.get_default_differential_drive()


board.wait_for_button()
for count in range(4):
  differentialDrive.straight(20, 0.5)
  differentialDrive.turn(90, 0.5)
"
